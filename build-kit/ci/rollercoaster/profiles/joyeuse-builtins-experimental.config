# Joyeuse experiment ONLY. Appended to the Synthetica 2.0 profile in a
# disposable build-kit copy, never to the existing release build.
# These in-tree implementations are candidates, not proven equivalents of
# the original vendor modules. Runtime and hardware behavior remain untested.
CONFIG_BRIDGE_NETFILTER=y
CONFIG_USB_GSPCA=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_QCOM_LLCC_PERFMON=y

# Keep existing Synthetica built-ins and security requirements explicit.
CONFIG_QCA_CLD_WLAN=y
CONFIG_EXFAT_FS=y
CONFIG_MODULES=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
# CONFIG_MODULE_FORCE_LOAD is not set
# CONFIG_SECURITY_SELINUX_DISABLE is not set
