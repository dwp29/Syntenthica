# Fresh-Milk / CHEESE-BURGER — fragment bersama
# Hanya berisi permintaan yang TERBUKTI ada simbolnya di source 4.14.357.
# Setiap baris harus lolos `check-config`; kalau tidak, build gagal.

# Kompresi zram: zstd sebagai opsi ketiga (lz4 & lz4kd sudah ada di 3.2)
CONFIG_CRYPTO_ZSTD=y

# Kompresi satu-kali: boot image lebih kecil
CONFIG_CRYPTO_LZ4HC=y

# Wajib untuk Mountify (xattr di tmpfs)
CONFIG_TMPFS_XATTR=y
