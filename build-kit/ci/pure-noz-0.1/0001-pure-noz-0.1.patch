+CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
+CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+CONFIG_CPU_BOOST=y
+
+# eBPF: BPF_EVENTS/UPROBE_EVENTS live inside "if FTRACE"; without them Android 17 bootloops
+CONFIG_FTRACE=y
+CONFIG_UPROBES=y
+CONFIG_UPROBE_EVENTS=y
+CONFIG_BPF_EVENTS=y
+CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
