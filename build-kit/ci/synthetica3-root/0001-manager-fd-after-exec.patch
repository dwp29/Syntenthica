+/*
+ * The Manager's libksud.so starts via exec, which closes the Manager's
+ * original O_CLOEXEC driver fd. Give this one recognized UID a fresh *normal*
+ * fd only after a successful helper exec. The ioctl layer still applies its
+ * existing caller checks, and this fd also closes on the next exec. Do not
+ * grant a su-session fd or change the inherited seccomp filter.
+ */
+void ksu_install_manager_exec_fd(const char *filename)
+{
+	const char *name;
+
+	if (!filename || !ksu_is_manager_appid_valid() || !is_manager())
+		return;
+
+	name = strrchr(filename, '/');
+	if (!name || strcmp(name + 1, "libksud.so"))
+		return;
+
+	if (ksu_install_fd() < 0)
+		pr_warn("ksu: could not install Manager helper fd after exec\n");
+}
