<?xml version="1.0" encoding="utf-8"?>
<!-- No root, shell, native payload, device-control permission, or network access. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Reject networking if any debug support library would otherwise add it. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_synthetica_emblem"
        android:label="Synthetica Neon Preview"
        android:theme="@style/Theme.NeonPreview">
        <activity
            android:name="com.rifsxd.ksunext.PreviewActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
