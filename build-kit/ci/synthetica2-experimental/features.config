# Synthetica 2.0 experiment: no overclock, thermal change, or new automatic boost.
# Keep the existing WALT + schedtune path; Uclamp requests default to neutral.
CONFIG_SCHED_WALT=y
CONFIG_SCHED_TUNE=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=5

# Compile MGLRU for controlled testing, but do not turn it on at boot before
# device-specific suspend, charging, memory-pressure, and recovery tests.
CONFIG_LRU_GEN=y
# CONFIG_LRU_GEN_ENABLED is not set
# CONFIG_LRU_GEN_STATS is not set
CONFIG_NR_LRU_GENS=7
CONFIG_TIERS_PER_GEN=4
