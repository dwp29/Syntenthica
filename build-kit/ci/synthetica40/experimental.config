# EXPERIMENT ONLY. This is not a validated 4.0 release or a flashable image.
# Applied after the pinned miatoll + LineageOS bring-up fragments.
CONFIG_LOCALVERSION="-synthetica-4.0-dev0"
# CONFIG_LOCALVERSION_AUTO is not set

# Actual NoMount 2.2.0 sources and matching protocol-22 userspace; no prebuilt GKI LKM.
CONFIG_NOMOUNT=y
# KernelSU-Next 3.4.2 uses UAPI 5. Existing Synthetica Manager 5.0.1 is UAPI 4.
CONFIG_KPROBES=y
# KernelSU redirects selected syscalls via the sys_enter tracepoint. Merely
# having HAVE_SYSCALL_TRACEPOINTS is insufficient when tracing is disabled.
CONFIG_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_TRACEPOINTS=y
CONFIG_EXT4_FS=y
CONFIG_KSU=y
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set

# Preserve relevant security switches; this does not guarantee trust of target ROM modules.
CONFIG_MODULES=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FS_VERITY=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
CONFIG_FS_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y

# MGLRU, task clamps, memory pressure and zRAM algorithms from 3.1/r1's baseline.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_MEMCG=y
CONFIG_PSI=y
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZO=y

# Networking and BPF features enabled in the previous baseline where supported.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BIC=m
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=m
CONFIG_TCP_CONG_HTCP=m
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
