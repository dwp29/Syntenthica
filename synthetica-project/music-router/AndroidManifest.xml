<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.syntenthica.musicrouter"
    android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <queries>
        <package android:name="com.codetrio.spatialflow" />
    </queries>
    <application android:allowBackup="false" android:usesCleartextTraffic="false"
        android:label="SpatialFlow" android:icon="@android:drawable/ic_media_play">
        <activity android:name=".MusicPlayerRouter" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
