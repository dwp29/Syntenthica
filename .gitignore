# Private signing keys - NEVER commit or upload
secretkey/
*.p12
*.jks
*.keystore
*.pem
*.der
*.key

# Raw extracted trees / downloads
kernel-tree/
manager-source/
Synthetica-2.0-SOURCE*
google_drive/
.work-*

out/
__pycache__/
*.pyc

# CI kernel and package binaries belong in the CI artifact, never in git
# history. Their digests are committed as BINARY-SHA256.txt instead.
build-kit/artifacts/*.gz
build-kit/artifacts/*.zip
build-kit/artifacts/*.img
ci-stage/step1/*.apk
ci-stage/step21/*.apk

# Raw, un-cropped theme art. Only the processed assets in the app tree ship.
wip/

# Unsigned APKs produced by build-kit/scripts/build_manager_60_standalone.py.
# They are build output; the pinned inputs stay in git, this does not.
artifacts/unsigned/

# Local distribution bundles (APKs and signing material must never be committed).
dist/
Synthetica-Manager-6.1-Themes-SIGNED.apk
*.apk
